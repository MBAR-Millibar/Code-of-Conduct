{
  "config": {
    "default": true,
    // Long lines are fine: tables, links and translations.
    "MD013": false,
    // Files start with a version/translation header comment.
    "MD041": false,
    // Allow repeated headings in different sections.
    "MD024": { "siblings_only": true }
  },
  "ignores": ["node_modules/**", "LICENSE"]
}
